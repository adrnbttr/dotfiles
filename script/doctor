#!/usr/bin/env bash
# Diagnostic de l'installation : ce qui est en place, ce qui manque, et comment
# le réparer.
#
#   ./script/doctor          état des lieux
#   ./script/doctor --fix    relance les étapes d'installation manquantes
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib-ui.sh disable=SC1091
source "$repo_root/script/lib-ui.sh"

fix=false
[[ "${1:-}" == "--fix" ]] && fix=true

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
is_wsl=false
grep -qi microsoft /proc/version 2>/dev/null && is_wsl=true
# Même PATH que zsh : opencode, claude... s'installent hors de /usr/bin.
for d in "$HOME/.local/bin" "$HOME/.opencode/bin"; do
  [[ -d "$d" && ":$PATH:" != *":$d:"* ]] && PATH="$d:$PATH"
done
have() { command -v "$1" >/dev/null 2>&1; }
version_ge() { [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" == "$2" ]]; }

OK=0; WARN=0; BAD=0
MISSING_STEPS=()

section() { printf '\n%s%s%s\n' "$UI_BOLD" "$1" "$UI_RESET"; }
good() { printf '  %s✓%s %s\n' "$UI_GREEN" "$UI_RESET" "$*"; OK=$((OK + 1)); }
meh() { printf '  %s!%s %s\n' "$UI_YELLOW" "$UI_RESET" "$*"; WARN=$((WARN + 1)); }
bad() { printf '  %s✗%s %s\n' "$UI_RED" "$UI_RESET" "$*"; BAD=$((BAD + 1)); }

# check <libellé> <commande> [étape d'installation] [obligatoire]
check() {
  local label="$1" cmd="$2" step="${3:-}" required="${4:-false}"
  if have "$cmd"; then
    good "$label"
    return
  fi
  [[ -n "$step" ]] && MISSING_STEPS+=("$step")
  if [[ "$required" == "true" ]]; then
    bad "$label — manquant${step:+ (étape « $step »)}"
  else
    meh "$label — manquant${step:+ (étape « $step »)}"
  fi
}

printf '\n%s❯ dotfiles · diagnostic%s\n' "$UI_BOLD" "$UI_RESET"
printf '%s  dépôt : %s · système : %s%s%s\n' "$UI_DIM" "$repo_root" "$os" "$([[ $is_wsl == true ]] && echo ' (WSL)')" "$UI_RESET"

section "indispensables"
check "git" git base true
check "stow (liens symboliques)" stow base true
check "zsh" zsh base true
check "jq (sessions WezTerm)" jq base true

section "terminal"
if [[ "$is_wsl" == true ]]; then
  # WezTerm tourne côté Windows (script/get.ps1) et lit ~\.wezterm.lua.
  if have wezterm.exe; then
    good "WezTerm Windows $(wezterm.exe --version 2>/dev/null | tr -d '\r' | awk '{print $2}')"
  else
    meh "WezTerm Windows introuvable (relance script/get.ps1 dans PowerShell)"
  fi
  win_home="$(wslpath "$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')" 2>/dev/null)"
  if [[ -n "$win_home" && -f "$win_home/.wezterm.lua" ]] && grep -q "dotfiles" "$win_home/.wezterm.lua"; then
    good "WezTerm Windows pointe sur cette config (~\\.wezterm.lua)"
  else
    meh "WezTerm Windows ne charge pas cette config (relance script/get.ps1)"
  fi
elif have wezterm; then
  good "WezTerm $(wezterm --version 2>/dev/null | awk '{print $2}')"
else
  MISSING_STEPS+=(wezterm); meh "WezTerm — manquant (étape « wezterm »)"
fi
if [[ -f "$HOME/.config/wezterm/wezterm.lua" ]]; then
  good "config WezTerm liée"
else
  MISSING_STEPS+=(link); meh "config WezTerm absente (étape « link »)"
fi
if [[ -x "$HOME/.local/bin/wez-pick" ]]; then
  good "sélecteur wez-pick"
else
  MISSING_STEPS+=(link); meh "wez-pick absent (étape « link »)"
fi
if [[ "$is_wsl" == true ]]; then
  : # Sous Windows, wezterm.lua ne pose pas TERM=wezterm : terminfo inutile.
elif infocmp wezterm >/dev/null 2>&1; then
  good "terminfo wezterm (soulignement ondulé)"
else
  MISSING_STEPS+=(wezterm); meh "terminfo wezterm absent (étape « wezterm »)"
fi
if have fzf; then
  fzf_ver="$(fzf --version 2>/dev/null | awk '{print $1}')"
  if version_ge "$fzf_ver" "0.36.0"; then good "fzf $fzf_ver"; else MISSING_STEPS+=(fzf); meh "fzf $fzf_ver trop ancien (0.36 minimum)"; fi
else
  MISSING_STEPS+=(fzf); bad "fzf — manquant (étape « fzf »)"
fi

section "zsh"
if [[ -d "$HOME/.oh-my-zsh" ]]; then good "oh-my-zsh"; else MISSING_STEPS+=(link); meh "oh-my-zsh absent (étape « link »)"; fi
zsh_custom="${ZSH_CUSTOM:-${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-zsh}"
if [[ -f "$zsh_custom/themes/adrien-agnoster.zsh-theme" ]]; then good "thème adrien-agnoster"; else MISSING_STEPS+=(link); meh "thème absent (étape « link »)"; fi
plugins="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
for p in zsh-autosuggestions fast-syntax-highlighting fzf-tab; do
  if [[ -d "$plugins/$p" ]]; then good "$p"; else MISSING_STEPS+=(link); meh "$p absent (étape « link »)"; fi
done
if [[ -f "$HOME/.zshrc" ]]; then good ".zshrc lié"; else MISSING_STEPS+=(link); bad ".zshrc absent (étape « link »)"; fi
if [[ "$os" == "linux" ]]; then
  login_shell="$(getent passwd "$USER" 2>/dev/null | cut -d: -f7)"
  if [[ "${login_shell##*/}" == "zsh" ]]; then
    good "zsh shell par défaut"
  else
    MISSING_STEPS+=(shell); meh "shell par défaut : ${login_shell:-?}, pas zsh (étape « shell »)"
  fi
fi

if [[ "$is_wsl" == true ]]; then
  section "git (WSL)"
  if [[ -n "$(git config --global user.email)" ]]; then good "identité git ($(git config --global user.email))"; else MISSING_STEPS+=(git); meh "identité git absente (étape « git »)"; fi
  if git config --global --get-all credential.https://github.com.helper 2>/dev/null | grep -q "auth git-credential"; then
    good "accès GitHub via gh Windows (dépôts privés)"
  else
    MISSING_STEPS+=(git); meh "pas d'accès GitHub pour les dépôts privés (étape « git »)"
  fi
fi

section "outils"
check "ripgrep (rg)" rg base
check "neovim (github-session, de-session...)" nvim optional
check "lazygit" lazygit lazygit
check "lazydocker" lazydocker lazydocker
check "psql (vim-dadbod)" psql base
check "Claude Code" claude claude
check "opencode" opencode opencode
if have fd || have fdfind; then good "fd"; else MISSING_STEPS+=(base); meh "fd — manquant (étape « base »)"; fi
if have bat || have batcat; then good "bat"; else MISSING_STEPS+=(base); meh "bat — manquant (étape « base »)"; fi
if have pyenv; then
  if pyenv commands 2>/dev/null | grep -qx virtualenv-init; then good "pyenv + virtualenv"; else MISSING_STEPS+=(pyenv); meh "plugin pyenv-virtualenv absent (étape « pyenv »)"; fi
else
  meh "pyenv — manquant (optionnel)"
fi

section "neovim"
if [[ -f "$repo_root/config/.config/nvim/lazy-lock.json" ]]; then good "lazy-lock.json versionné"; else meh "lazy-lock.json absent"; fi
if [[ -d "$HOME/.local/share/nvim/mason/packages" ]]; then
  mason_count=$(find "$HOME/.local/share/nvim/mason/packages" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
  good "$mason_count outils Mason (LSP, formateurs)"
else
  meh "aucun outil Mason (ouvre nvim une fois)"
fi

# --- Résumé --------------------------------------------------------------------
printf '\n%s─────────────────────────────────────────────%s\n' "$UI_DIM" "$UI_RESET"
printf '%s%s en place · %s à regarder · %s bloquants%s\n' \
  "$UI_BOLD" "$OK" "$WARN" "$BAD" "$UI_RESET"

if (( ${#MISSING_STEPS[@]} > 0 )); then
  uniq_steps="$(printf '%s\n' "${MISSING_STEPS[@]}" | sort -u | tr '\n' ' ' | sed 's/ $//')"
  if [[ "$fix" == "true" ]]; then
    printf '\nRéparation : ./script/install --only "%s"\n\n' "$uniq_steps"
    exec "$repo_root/script/install" --only "$uniq_steps"
  fi
  printf '\nPour réparer :\n  %s./script/doctor --fix%s\n' "$UI_BOLD" "$UI_RESET"
  printf '  %s(équivaut à ./script/install --only "%s")%s\n' "$UI_DIM" "$uniq_steps" "$UI_RESET"
fi

(( BAD == 0 ))
