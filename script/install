#!/usr/bin/env bash
# Les fonctions d'installation sont appelées indirectement par step(), ce que
# l'analyse statique ne voit pas : selon sa version, elle les signale comme
# jamais appelées (SC2329) ou inatteignables (SC2317).
# shellcheck disable=SC2317,SC2329
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

have() { command -v "$1" >/dev/null 2>&1; }

version_ge() {
  # usage: version_ge <have> <want>
  # returns 0 if have >= want (sort -V)
  local have_ver="$1" want_ver="$2"
  [[ "$(printf '%s\n%s\n' "$have_ver" "$want_ver" | sort -V | head -n 1)" == "$want_ver" ]]
}

info() { printf "%s\n" "$*"; }
warn() { printf "warn %s\n" "$*" >&2; }
err() { printf "error %s\n" "$*" >&2; }

os="$(uname -s | tr '[:upper:]' '[:lower:]')"

# Les outils téléchargés depuis GitHub atterrissent dans ~/.local/bin : sur une
# machine neuve, ce dossier n'existe pas encore et n'est donc pas dans le PATH
# (cf. ~/.profile d'Ubuntu). Sans ça, les vérifications « have <outil> » qui
# suivent l'installation échouent alors que tout s'est bien passé.
mkdir -p "$HOME/.local/bin"
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

usage() {
  cat <<'EOF'
Usage:
  ./script/install [options]

Options:
  --minimal           Installe uniquement les outils CLI de base
  --no-gui            Saute les applis graphiques (kitty, wezterm)
  --no-opencode       Saute opencode
  --no-claude         Saute Claude Code
  --upgrade           Met à jour les paquets Homebrew déjà installés (macOS)
  --dry-run           Affiche ce qui serait fait, sans rien installer
  --only "a b"        N'exécute que ces étapes (cf. --list)
  --skip "a b"        Saute ces étapes
  --list              Liste les étapes et sort
  --yes               Ne pose aucune question
  --opencode-version <version>  Version précise d'opencode
  --claude-version <version>    Version précise de Claude Code
  -h, --help          Affiche cette aide
EOF
}

minimal=false
no_gui=false
no_opencode=false
no_claude=false
upgrade=false
assume_yes=false
list_only=false
opencode_version="${OPENCODE_VERSION:-}"
claude_version="${CLAUDE_VERSION:-}"
export DOTFILES_DRY_RUN="${DOTFILES_DRY_RUN:-}"
export DOTFILES_ONLY="${DOTFILES_ONLY:-}"
export DOTFILES_SKIP="${DOTFILES_SKIP:-}"

# shellcheck source=lib-ui.sh disable=SC1091
source "$repo_root/script/lib-ui.sh"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --minimal) minimal=true; shift ;;
    --no-gui) no_gui=true; shift ;;
    --no-opencode) no_opencode=true; shift ;;
    --no-claude) no_claude=true; shift ;;
    --upgrade) upgrade=true; shift ;;
    --dry-run) DOTFILES_DRY_RUN=1; shift ;;
    --yes|-y) assume_yes=true; shift ;;
    --list) list_only=true; shift ;;
    --only) DOTFILES_ONLY="${2:-}"; shift 2 ;;
    --skip) DOTFILES_SKIP="${2:-}"; shift 2 ;;
    --opencode-version)
      opencode_version="${2:-}"
      if [[ -z "$opencode_version" ]]; then
        err "--opencode-version requires a value"
        exit 2
      fi
      shift 2
      ;;
    --claude-version)
      claude_version="${2:-}"
      if [[ -z "$claude_version" ]]; then
        err "--claude-version requires a value"
        exit 2
      fi
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *)
      err "unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

brew_install_if_missing() {
  local pkg="$1"
  if brew list --versions "$pkg" >/dev/null 2>&1; then
    return 0
  fi
  brew install "$pkg"
}

brew_cask_install_if_missing() {
  local pkg="$1"
  if brew list --cask "$pkg" >/dev/null 2>&1; then
    return 0
  fi
  brew install --cask "$pkg"
}

sudo_cmd=""
if [[ ${EUID:-0} -ne 0 ]]; then
  if have sudo; then
    sudo_cmd="sudo"
  else
    err "need root privileges (install sudo or run as root)"
    exit 1
  fi
fi

install_opencode() {
  if [[ "$no_opencode" == "true" ]]; then
    return 0
  fi
  if have opencode; then
    return 0
  fi
  if ! have curl; then
    err "curl is required to install opencode"
    exit 1
  fi
  info "installing opencode (official installer)"
  if [[ -n "$opencode_version" ]]; then
    curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path --version "$opencode_version"
  else
    curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path
  fi
}

install_claude() {
  if [[ "$no_claude" == "true" ]]; then
    return 0
  fi
  if have claude; then
    info "Claude Code already installed"
    return 0
  fi
  if ! have curl; then
    err "curl is required to install Claude Code"
    exit 1
  fi
  info "installing Claude Code..."
  
  # Use the dedicated installation script
  local -a install_args=()
  if [[ -n "$claude_version" ]]; then
    install_args=(--version "$claude_version")
  fi

  # Run the Claude installation script
  "$repo_root/script/install-claude" "${install_args[@]}"
  
  if have claude; then
    info "✓ Claude Code installed successfully"
  else
    warn "Claude Code installation may need manual setup"
    warn "Check: ./script/install-claude --help"
  fi
}

install_voice_to_claude() {
  if ! have apt-get; then
    warn "voice-to-claude setup skipped (non-apt OS)"
    return 0
  fi

  info "installing voice-to-claude system deps (python3-venv, pulseaudio, notify, ffmpeg)"
  ${sudo_cmd} apt-get install -y \
    python3-venv \
    pulseaudio-utils \
    libnotify-bin \
    ffmpeg

  local venv="$HOME/.local/share/voice-to-claude/venv"
  if [[ ! -x "$venv/bin/python" ]]; then
    info "creating faster-whisper venv at $venv"
    mkdir -p "$(dirname "$venv")"
    python3 -m venv "$venv"
    "$venv/bin/pip" install --upgrade pip
    "$venv/bin/pip" install faster-whisper
  fi

  info "pre-downloading Whisper 'small' model (~150 MB on first run)"
  "$venv/bin/python" - <<'PY' || warn "model pre-download failed (will retry at first use)"
from faster_whisper import WhisperModel
WhisperModel("small", device="cpu", compute_type="int8")
PY
}

configure_cinnamon_keybind() {
  if ! have gsettings; then
    warn "gsettings not found; skip Cinnamon keybinding"
    return 0
  fi
  if [[ "${XDG_CURRENT_DESKTOP:-}" != *"Cinnamon"* ]] && [[ "${DESKTOP_SESSION:-}" != *"cinnamon"* ]]; then
    info "not running Cinnamon; skip keybinding (bind manually to $HOME/.local/bin/voice-to-claude)"
    return 0
  fi

  local key_id="voice-to-claude"
  local bind_path="/org/cinnamon/desktop/keybindings/custom-keybindings/${key_id}/"
  local schema="org.cinnamon.desktop.keybindings.custom-keybinding:${bind_path}"

  gsettings set "$schema" name "Voice to Claude"
  gsettings set "$schema" command "$HOME/.local/bin/voice-to-claude"
  gsettings set "$schema" binding "['<Super>v']"

  local current
  current="$(gsettings get org.cinnamon.desktop.keybindings custom-list 2>/dev/null || echo "@as []")"
  if [[ "$current" != *"'${key_id}'"* ]]; then
    if [[ "$current" == "@as []" || "$current" == "[]" ]]; then
      gsettings set org.cinnamon.desktop.keybindings custom-list "['${key_id}']"
    else
      gsettings set org.cinnamon.desktop.keybindings custom-list "${current%]}, '${key_id}']"
    fi
  fi
  info "Cinnamon shortcut <Super>v → voice-to-claude"
}

install_fzf_release_linux() {
  local ver="${1:-}"
  if [[ -z "$ver" ]]; then
    err "install_fzf_release_linux requires a version"
    exit 2
  fi
  if ! have curl; then
    err "curl is required to install fzf"
    exit 1
  fi
  if ! have tar; then
    err "tar is required to install fzf"
    exit 1
  fi
  if ! have sha256sum; then
    err "sha256sum is required to install fzf"
    exit 1
  fi

  local arch
  case "$(uname -m)" in
    x86_64) arch="linux_amd64" ;;
    aarch64|arm64) arch="linux_arm64" ;;
    *)
      err "unsupported architecture for fzf install: $(uname -m)"
      exit 1
      ;;
  esac

  local url_base="https://github.com/junegunn/fzf/releases/download/v${ver}"
  local file="fzf-${ver}-${arch}.tar.gz"

  info "installing fzf ${ver} (${arch}) to ~/.local/bin/fzf"
  mkdir -p "$HOME/.local/bin"

  local tmpdir
  tmpdir="$(mktemp -d)"
  ( set -euo pipefail
    trap 'rm -rf "$tmpdir"' EXIT
    cd "$tmpdir"
    curl -fsSL -o "$file" "$url_base/$file"
    curl -fsSL -o checksums.txt "$url_base/fzf_${ver}_checksums.txt"
    grep "$file" checksums.txt > expected.txt
    sha256sum -c expected.txt
    tar -xzf "$file"
    install -m 0755 -D ./fzf "$HOME/.local/bin/fzf"
  )
}

ensure_fzf_recent_linux() {
  local min="0.36.0"
  local desired="${FZF_VERSION:-0.67.0}"

  if have fzf; then
    local current
    current="$(fzf --version 2>/dev/null | awk '{print $1}' || true)"
    if [[ -n "$current" ]] && version_ge "$current" "$min"; then
      return 0
    fi
    warn "fzf ${current:-unknown} is too old for fzf-lua (need >= ${min}); installing ${desired}"
  else
    warn "fzf missing; installing ${desired}"
  fi

  install_fzf_release_linux "$desired"
}

install_lazygit_release_linux() {
  local version="${1:-0.44.1}"
  local url="https://github.com/jesseduffield/lazygit/releases/download/v${version}/lazygit_${version}_Linux_x86_64.tar.gz"
  local tmpdir
  tmpdir=$(mktemp -d)
  (
    cd "$tmpdir"
    curl -fsSL -o lazygit.tar.gz "$url" || { err "failed to download lazygit ${version}"; exit 1; }
    tar -xzf lazygit.tar.gz || { err "failed to extract lazygit"; exit 1; }
    install -m 0755 -D ./lazygit "$HOME/.local/bin/lazygit"
  )
  rm -rf "$tmpdir"
}

ensure_lazygit_linux() {
  local version="${LAZYGIT_VERSION:-0.44.1}"

  # Check if force reinstall
  if [[ "${LAZYGIT_FORCE:-}" == "1" ]]; then
    info "LAZYGIT_FORCE=1: reinstalling lazygit ${version}"
    rm -f "$HOME/.local/bin/lazygit"
  elif have lazygit; then
    info "lazygit already installed ($(lazygit --version 2>/dev/null | head -1 | awk '{print $6}'))"
    return 0
  fi

  info "installing lazygit ${version} from GitHub"
  install_lazygit_release_linux "$version"

  # Verify installation
  if have lazygit; then
    info "lazygit ${version} installed successfully"
  else
    err "lazygit installation failed"
    return 1
  fi
}

