# Libère ctrl+alt+flèches et ctrl+alt+shift+flèches pour le terminal (focus et
# création de splits dans WezTerm/kitty) : les bureaux Cinnamon passent sur
# super+ctrl+flèches (changer) et super+ctrl+shift+flèches (y déplacer la fenêtre).
configure_cinnamon_workspace_keys() {
  if ! have gsettings || ! gsettings list-schemas 2>/dev/null | grep -qx org.cinnamon.desktop.keybindings.wm; then
    return 0
  fi
  local schema="org.cinnamon.desktop.keybindings.wm" dir lower
  for dir in Left Right Down; do
    lower="$(printf '%s' "$dir" | tr '[:upper:]' '[:lower:]')"
    gsettings set "$schema" "switch-to-workspace-${lower}" "['<Super><Control>${dir}']"
    gsettings set "$schema" "move-to-workspace-${lower}" "['<Super><Control><Shift>${dir}']"
  done
  gsettings set "$schema" switch-to-workspace-up "['<Super><Control>Up', '<Alt>F1']"
  gsettings set "$schema" move-to-workspace-up "['<Super><Control><Shift>Up']"
  info "Cinnamon workspaces moved to Super+Ctrl(+Shift)+arrows (terminal keeps Ctrl+Alt+arrows)"
}

# Terminfo `wezterm` (TERM=wezterm dans wezterm.lua : soulignement ondulé des
# diagnostics nvim). Compilé dans ~/.terminfo, sans sudo.
ensure_wezterm_terminfo() {
  if infocmp wezterm >/dev/null 2>&1; then
    return 0
  fi
  if ! have tic; then
    warn "tic not found: skipping wezterm terminfo"
    return 0
  fi
  local tmp
  tmp="$(mktemp)"
  if curl -fsSL -o "$tmp" https://raw.githubusercontent.com/wezterm/wezterm/main/termwiz/data/wezterm.terminfo \
    && tic -x -o "$HOME/.terminfo" "$tmp"; then
    info "wezterm terminfo installed in ~/.terminfo"
  else
    warn "wezterm terminfo install failed"
  fi
  rm -f "$tmp"
}

# WezTerm via son dépôt apt officiel (le paquet Ubuntu est trop ancien ou absent).
# Sous WSL, c'est WezTerm Windows qui tourne (script/get.ps1) :
# rien à installer côté Linux.
ensure_wezterm_linux() {
  if grep -qi microsoft /proc/version 2>/dev/null; then
    info "WSL detected: wezterm is installed on the Windows side (script/get.ps1)"
    return 0
  fi
  if ! have wezterm; then
    info "installing wezterm (apt.fury.io/wez)"
    curl -fsSL https://apt.fury.io/wez/gpg.key \
      | ${sudo_cmd} gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg
    echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' \
      | ${sudo_cmd} tee /etc/apt/sources.list.d/wezterm.list >/dev/null
    # apt-get update peut échouer à cause d'un autre dépôt cassé : on tente
    # l'installation quand même.
    ${sudo_cmd} apt-get update || true
    if ! ${sudo_cmd} apt-get install -y wezterm; then
      warn "wezterm install failed"
      return 0
    fi
  else
    info "wezterm already installed ($(wezterm --version 2>/dev/null))"
  fi
  ensure_wezterm_terminfo
}

ensure_bottom_linux() {
  local version="${BOTTOM_VERSION:-0.9.6}"

  if [[ "${BOTTOM_FORCE:-}" == "1" ]]; then
    info "BOTTOM_FORCE=1: reinstalling bottom ${version}"
    rm -f "$HOME/.local/bin/btm"
  elif have btm; then
    info "bottom already installed ($(btm --version 2>/dev/null))"
    return 0
  fi

  info "installing bottom ${version} from GitHub"
  install_bottom_release_linux "$version"

  if have btm; then
    info "bottom ${version} installed successfully"
  else
    err "bottom installation failed"
    return 1
  fi
}

# --- Vérifications préalables --------------------------------------------------
preflight() {
  local problems=0
  printf '%svérifications%s\n' "$UI_BOLD" "$UI_RESET"

  case "$os" in
    linux)
      if have apt-get; then
        printf '  ✓ système : Linux (apt)\n'
      else
        printf '  %s✗ système : apt-get introuvable (distributions Debian/Ubuntu uniquement)%s\n' "$UI_RED" "$UI_RESET"
        problems=1
      fi
      if grep -qi microsoft /proc/version 2>/dev/null; then
        printf '  ✓ WSL détecté : WezTerm s'"'"'installe côté Windows (script/get.ps1)\n'
      fi
      ;;
    darwin)
      if have brew; then
        printf '  ✓ système : macOS (Homebrew)\n'
      else
        printf '  %s✗ Homebrew absent : https://brew.sh%s\n' "$UI_RED" "$UI_RESET"
        problems=1
      fi
      ;;
    *)
      printf '  %s✗ système non pris en charge : %s%s\n' "$UI_RED" "$os" "$UI_RESET"
      problems=1
      ;;
  esac

  if [[ -z "$sudo_cmd" ]] || sudo -n true 2>/dev/null; then
    printf '  ✓ droits administrateur\n'
  else
    printf '  %s! mot de passe sudo demandé pendant l'"'"'installation%s\n' "$UI_YELLOW" "$UI_RESET"
  fi

  if have curl && curl -fsI --max-time 8 https://github.com >/dev/null 2>&1; then
    printf '  ✓ accès réseau (github.com)\n'
  else
    printf '  %s✗ pas d'"'"'accès à github.com (curl absent ou réseau coupé)%s\n' "$UI_RED" "$UI_RESET"
    problems=1
  fi

  local free_mb
  free_mb=$(df -Pm "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
  if [[ -n "$free_mb" && "$free_mb" -lt 2048 ]]; then
    printf '  %s! espace disque faible : %s Mo libres (2 Go conseillés)%s\n' "$UI_YELLOW" "$free_mb" "$UI_RESET"
  else
    printf '  ✓ espace disque : %s Mo libres\n' "${free_mb:-?}"
  fi

  if [[ "$os" == "linux" ]] && have apt-get; then
    local broken
    broken=$(${sudo_cmd} apt-get update 2>&1 | grep -cE '^(E|W): ' || true)
    if [[ "${broken:-0}" -gt 0 ]]; then
      printf '  %s! %s dépôt(s) apt en erreur : l'"'"'installation continue, mais ces sources sont ignorées%s\n' \
        "$UI_YELLOW" "$broken" "$UI_RESET"
      printf '    %s(détail : sudo apt-get update)%s\n' "$UI_DIM" "$UI_RESET"
    else
      printf '  ✓ dépôts apt à jour\n'
    fi
  fi

  printf '\n'
  if (( problems > 0 )); then
    ui_error "prérequis manquants : voir ci-dessus"
    exit 1
  fi
}

# --- Étapes --------------------------------------------------------------------
apt_base_linux() {
  local pkgs=(
    ca-certificates curl git stow zsh fzf ripgrep fd-find bat tar
    # Utilisé par les sessions WezTerm/kitty de .zshrc
    jq
    # Utilisé par vim-dadbod pour les requêtes PostgreSQL
    postgresql-client
  )
  ${sudo_cmd} apt-get install -y "${pkgs[@]}"
}

apt_optional_linux() {
  local pkgs=(autojump neovim)
  if ! ${sudo_cmd} apt-get install -y "${pkgs[@]}"; then
    warn "certains paquets optionnels n'ont pas pu être installés : ${pkgs[*]}"
  fi
}

brew_base_macos() {
  export HOMEBREW_NO_AUTO_UPDATE=1
  local pkg
  for pkg in git stow jq zsh fzf ripgrep fd bat pyenv lazygit lazydocker libpq; do
    brew_install_if_missing "$pkg"
  done
}

brew_optional_macos() {
  brew_install_if_missing autojump
  brew_install_if_missing neovim
  brew_install_if_missing eza
  brew_install_if_missing zoxide
  brew_install_if_missing git-delta
  brew_install_if_missing bottom
  if [[ "$upgrade" == "true" ]]; then
    brew upgrade git stow zsh fzf ripgrep fd bat pyenv lazygit autojump neovim || true
  fi
}

brew_terminals_macos() {
  brew_cask_install_if_missing kitty >/dev/null 2>&1 || warn "kitty déjà présent hors brew"
  brew_cask_install_if_missing wezterm >/dev/null 2>&1 || warn "WezTerm déjà présent hors brew"
  ensure_wezterm_terminfo
}

modern_tools_linux() {
  ensure_eza_linux
  ensure_zoxide_linux
  ensure_delta_linux
  ensure_bottom_linux
}

run_bootstrap() { "$repo_root/script/bootstrap"; }

# zsh comme shell de connexion : c'est lui que WezTerm ouvre (et, sous Windows,
# la distribution WSL), et les sessions (github-session...) sont des fonctions zsh.
ensure_login_shell_zsh() {
  local zsh_bin current
  zsh_bin="$(command -v zsh)" || { warn "zsh absent : lance d'abord l'étape « base »"; return 1; }
  current="$(getent passwd "$USER" 2>/dev/null | cut -d: -f7)"
  if [[ "${current##*/}" == "zsh" ]]; then
    info "login shell already zsh ($current)"
    return 0
  fi
  grep -qx "$zsh_bin" /etc/shells 2>/dev/null || echo "$zsh_bin" | ${sudo_cmd} tee -a /etc/shells >/dev/null
  ${sudo_cmd} chsh -s "$zsh_bin" "$USER"
  info "login shell: ${current:-?} -> $zsh_bin"
}

# WSL uniquement : git y démarre sans identité ni accès GitHub (dépôts privés).
# On reprend l'identité de git Windows et on s'authentifie via le gh Windows
# (déjà connecté) : aucune clé ni jeton à recopier dans WSL.
configure_git_wsl() {
  if ! grep -qi microsoft /proc/version 2>/dev/null; then
    info "not WSL: git config left untouched"
    return 0
  fi
  local key val gh_win
  for key in user.name user.email; do
    if [[ -z "$(git config --global "$key")" ]] && have git.exe; then
      val="$(git.exe config --global "$key" 2>/dev/null | tr -d '\r')"
      [[ -n "$val" ]] && git config --global "$key" "$val" && info "git $key <- Windows ($val)"
    fi
  done
  gh_win="$(command -v gh.exe 2>/dev/null)"
  if [[ -z "$gh_win" ]]; then
    warn "gh.exe introuvable côté Windows : accès aux dépôts privés non configuré (winget install GitHub.cli, puis gh auth login)"
    return 0
  fi
  # Une valeur vide d'abord : ignore les helpers hérités, puis celui de gh.
  git config --global --unset-all credential.https://github.com.helper 2>/dev/null || true
  git config --global --add credential.https://github.com.helper ""
  git config --global --add credential.https://github.com.helper "!'$gh_win' auth git-credential"
  info "git credentials for github.com -> $gh_win"
}

# Liste des étapes (id + libellé + commande), selon l'OS et les options.
declare -a STEP_IDS=() STEP_LABELS=() STEP_CMDS=()
add_step() { STEP_IDS+=("$1"); STEP_LABELS+=("$2"); STEP_CMDS+=("$3"); }

build_steps() {
  case "$os" in
    linux)
      add_step lazygit    "lazygit"                 ensure_lazygit_linux
      add_step lazydocker "lazydocker"              ensure_lazydocker_linux
      add_step base       "outils de base (apt)"    apt_base_linux
      add_step fzf        "fzf récent"              ensure_fzf_recent_linux
      add_step tools      "eza, zoxide, delta, btm" modern_tools_linux
      [[ "$minimal" == "true" ]] || add_step optional "autojump, neovim"    apt_optional_linux
      if [[ "$minimal" != "true" && "$no_gui" != "true" ]]; then
        add_step wezterm  "WezTerm + terminfo"      ensure_wezterm_linux
      fi
      add_step pyenv      "plugin pyenv-virtualenv" ensure_pyenv_virtualenv_plugin
      [[ "$no_opencode" == "true" ]] || add_step opencode "opencode"        install_opencode
      [[ "$no_claude" == "true" ]]   || add_step claude   "Claude Code"     install_claude
      add_step voice      "dictée vocale (Whisper)" install_voice_to_claude
      add_step keys       "raccourcis Cinnamon"     configure_cinnamon_keys
      add_step shell      "zsh shell par défaut"    ensure_login_shell_zsh
      add_step git        "git (WSL : identité, GitHub)" configure_git_wsl
      ;;
    darwin)
      add_step base       "outils de base (brew)"   brew_base_macos
      [[ "$minimal" == "true" ]] || add_step optional "outils modernes"     brew_optional_macos
      if [[ "$minimal" != "true" && "$no_gui" != "true" ]]; then
        add_step wezterm  "kitty + WezTerm"         brew_terminals_macos
      fi
      add_step pyenv      "plugin pyenv-virtualenv" ensure_pyenv_virtualenv_plugin
      [[ "$no_opencode" == "true" ]] || add_step opencode "opencode"        install_opencode
      [[ "$no_claude" == "true" ]]   || add_step claude   "Claude Code"     install_claude
      ;;
  esac
  add_step link "liens symboliques (stow)" run_bootstrap
}

configure_cinnamon_keys() {
  configure_cinnamon_keybind
  configure_cinnamon_workspace_keys
}

build_steps

# --yes : aucune question, y compris celles d'apt.
if [[ "$assume_yes" == "true" ]]; then
  export DEBIAN_FRONTEND=noninteractive
fi

if [[ "$list_only" == "true" ]]; then
  printf 'Étapes de l'"'"'installation (%s) :\n' "$os"
  for i in "${!STEP_IDS[@]}"; do
    printf '  %-10s %s\n' "${STEP_IDS[$i]}" "${STEP_LABELS[$i]}"
  done
  exit 0
fi

ui_init "installation" "${#STEP_IDS[@]}"
preflight
for i in "${!STEP_IDS[@]}"; do
  step "${STEP_IDS[$i]}" "${STEP_LABELS[$i]}" "${STEP_CMDS[$i]}"
done

printf '\n'
ui_summary
rc=$?
if (( rc == 0 )); then
  printf '\n%sProchaine étape :%s ouvre un nouveau terminal (ou « exec zsh »).\n' "$UI_BOLD" "$UI_RESET"
  printf '  · WezTerm : F1 pour l'"'"'aide-mémoire, ctrl+shift+s pour les workspaces\n'
  printf '  · Diagnostic : ./script/doctor\n'
fi
exit $rc
