#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Liens que Stow (paquet `claude`) doit poser dans ~/.claude
expected_links=(
  "CLAUDE.md"
  "agents"
  "skills/lead"
  "skills/lead-stop"
)
settings_fragment="$repo_root/claude-state/settings.fragment.json"

show_logo() {
  cat <<'EOF'
   ____ _                   _      ___          _
  / ___| | __ _ ___ ___  __| |    / _ \___   __| |
 | |   | |/ _` / __/ __|/ _` |   | | | | \ \ / / |
 | |___| | (_| \__ \__ \ (_| |   | |_| | |\ V /|_|
  \____|_|\__,_|___/___/\__,_|    \___/|_| \_/ (_)
  Claude Code Manager v2.0
EOF
}

usage() {
  show_logo
  cat <<'EOF'

Usage :
  ./script/claude <commande>

Commandes :
  sync         Fusionne claude-state/settings.fragment.json dans ~/.claude/settings.json
  status       Affiche l'état des liens Stow, des réglages et du contenu versionné
  doctor       Vérifie l'installation (code de sortie 1 si un contrôle échoue)
  help         Affiche cette aide

Rappels :
  ./script/bootstrap               # pose les liens (Stow, paquet `claude`)
  ./script/claude sync             # fusionne la clé `env` dans settings.json
  ./script/claude status
  ./script/claude doctor
EOF
}

sync_usage() {
  cat <<'EOF'
Usage :
  ./script/claude sync

Fusionne (en profondeur, le fragment gagne) claude-state/settings.fragment.json
dans ~/.claude/settings.json. Le fichier est créé s'il n'existe pas ; sinon une
sauvegarde settings.json.bak-<date> est faite avant toute modification. Sans
changement, rien n'est écrit. Nécessite jq.
EOF
}

# Vrai si ~/.claude/<rel> résout (lien direct ou dossier parent replié par
# Stow) à l'intérieur de claude/.claude/ du dépôt.
resolved_in_repo() {
  local resolved
  resolved="$(readlink -f "$HOME/.claude/$1" 2>/dev/null || true)"
  [[ "$resolved" == "$repo_root/claude/.claude/"* ]]
}

# Vrai si le dossier réel ~/.claude/<rel> contient un lien vers chaque fichier
# versionné du dossier correspondant du dépôt (et au moins un).
dir_linked_per_file() {
  local src="$repo_root/claude/.claude/$1" f name found=false
  [[ -d "$src" ]] || return 1
  for f in "$src"/*; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f")"
    found=true
    resolved_in_repo "$1/$name" || return 1
  done
  [[ "$found" == "true" ]]
}

# link_state <rel> -> ok | autre | fichier | absent
link_state() {
  local target="$HOME/.claude/$1"
  if resolved_in_repo "$1"; then
    echo ok
  elif [[ ! -L "$target" && -d "$target" ]] && dir_linked_per_file "$1"; then
    # Dossier réel dans lequel Stow a posé des liens fichier par fichier
    echo ok
  elif [[ -L "$target" ]]; then
    echo autre
  elif [[ -e "$target" ]]; then
    echo fichier
  else
    echo absent
  fi
}

has_env_key() {
  local settings="$HOME/.claude/settings.json"
  command -v jq >/dev/null 2>&1 \
    && [[ -f "$settings" ]] \
    && jq -e '.env.CLAUDE_CODE_SUBAGENT_MODEL' "$settings" >/dev/null 2>&1
}

sync_settings() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "erreur : jq est requis (ex. sudo apt install jq)" >&2
    exit 1
  fi
  if [[ ! -f "$settings_fragment" ]]; then
    echo "erreur : $settings_fragment introuvable" >&2
    exit 1
  fi

  local settings="$HOME/.claude/settings.json" target tmp backup stamp
  mkdir -p "$HOME/.claude"

  if [[ ! -e "$settings" ]]; then
    cp -f "$settings_fragment" "$settings"
    echo "✓ $settings créé à partir du fragment"
    return 0
  fi

  # On écrit dans la cible réelle : un settings.json symlink reste un lien.
  target="$(readlink -f "$settings")"
  if [[ ! -w "$target" || ! -w "$(dirname "$target")" ]]; then
    echo "erreur : $target n'est pas inscriptible (fichier ou dossier) ; rien n'a été modifié" >&2
    exit 1
  fi

  # Temporaire dans le même dossier (mv atomique) ; cp -p garde le mode, et la
  # redirection de jq tronque sans le changer.
  tmp="$(mktemp "$target.tmp.XXXXXX")"
  cp -p "$target" "$tmp"
  if ! jq -s '.[0] * .[1]' "$target" "$settings_fragment" >"$tmp"; then
    rm -f "$tmp"
    echo "erreur : fusion impossible (settings.json est-il du JSON valide ?)" >&2
    exit 1
  fi

  if cmp -s <(jq -S . "$target") <(jq -S . "$tmp"); then
    rm -f "$tmp"
    echo "✓ $settings déjà à jour"
    return 0
  fi

  stamp="$(date +%Y%m%d-%H%M%S)"
  backup="$(mktemp "$target.bak-$stamp.XXXX")"
  cp -p "$target" "$backup"
  mv "$tmp" "$target"
  echo "✓ $settings mis à jour (sauvegarde : $backup)"
}

list_versioned() {
  local dir="$repo_root/claude/.claude" f
  echo "Agents versionnés :"
  for f in "$dir"/agents/*.md; do
    [[ -e "$f" ]] && echo "  - $(basename "$f")"
  done
  echo "Skills versionnés :"
  for f in "$dir"/skills/*/; do
    [[ -d "$f" ]] && echo "  - $(basename "$f")"
  done
  return 0
}

show_status() {
  echo "=== Claude Code Status ==="
  echo ""

  if command -v claude >/dev/null 2>&1; then
    local claude_version
    claude_version=$(claude --version 2>/dev/null | head -1 || echo "unknown")
    echo "  CLI claude : installée ($claude_version)"
  else
    echo "  CLI claude : NON INSTALLÉE"
    echo "  → Lancer : ./script/install-claude"
  fi

  if [[ -d "$HOME/.claude" ]]; then
    local session_count
    session_count=$(find "$HOME/.claude/projects" -name "*.jsonl" 2>/dev/null | wc -l | xargs || true)
    echo "  Sessions   : $session_count conversation(s) dans ~/.claude/projects/"
  else
    echo "  Sessions   : pas de ~/.claude/ — lancer 'claude --login'"
  fi
  echo ""

  if [[ -L "$HOME/.claude" ]]; then
    echo "  ✗ ~/.claude est un lien : sessions et identifiants finiraient dans le dépôt"
    echo ""
  fi

  echo "Liens Stow (paquet claude) :"
  local rel
  for rel in "${expected_links[@]}"; do
    case "$(link_state "$rel")" in
      ok) echo "  ✓ ~/.claude/$rel → dépôt" ;;
      autre) echo "  ✗ ~/.claude/$rel est un lien vers l'extérieur du dépôt" ;;
      fichier) echo "  ✗ ~/.claude/$rel est un fichier réel — à remplacer : ./script/bootstrap" ;;
      absent) echo "  - ~/.claude/$rel absent — lancer ./script/bootstrap" ;;
    esac
  done
  echo ""

  echo "Réglages (~/.claude/settings.json) :"
  if has_env_key; then
    echo "  ✓ env.CLAUDE_CODE_SUBAGENT_MODEL présent"
  else
    echo "  - env.CLAUDE_CODE_SUBAGENT_MODEL absent — lancer ./script/claude sync"
  fi
  echo ""

  list_versioned
}

run_doctor_checks() {
  echo "Claude Code Doctor — contrôles en cours..."
  echo ""
  local ok=true

  echo "1. CLI Claude"
  if command -v claude >/dev/null 2>&1; then
    local claude_version
    claude_version=$(claude --version 2>/dev/null | head -1 || echo "unknown")
    echo "   ✓ Installée : $claude_version"
  else
    echo "   ✗ NON INSTALLÉE"
    echo "   → Lancer : ./script/install-claude"
    ok=false
  fi
  echo ""

  echo "2. Répertoire ~/.claude"
  if [[ -L "$HOME/.claude" ]]; then
    echo "   ✗ ~/.claude est un lien : sessions et identifiants finiraient dans le dépôt"
    ok=false
  elif [[ -d "$HOME/.claude" ]]; then
    echo "   ✓ ~/.claude/ existe"
  else
    echo "   ✗ ~/.claude/ introuvable — lancer 'claude --login'"
    ok=false
  fi
  echo ""

  echo "3. Liens Stow (paquet claude)"
  local rel
  for rel in "${expected_links[@]}"; do
    case "$(link_state "$rel")" in
      ok) echo "   ✓ ~/.claude/$rel → dépôt" ;;
      absent)
        echo "   ✗ ~/.claude/$rel absent → ./script/bootstrap"
        ok=false
        ;;
      fichier)
        echo "   ✗ ~/.claude/$rel est un fichier réel → ./script/bootstrap"
        ok=false
        ;;
      *)
        echo "   ✗ ~/.claude/$rel pointe hors du dépôt → ./script/bootstrap"
        ok=false
        ;;
    esac
  done
  echo ""

  echo "4. Réglages (settings.json)"
  if ! command -v jq >/dev/null 2>&1; then
    echo "   ✗ jq manquant (requis pour sync)"
    ok=false
  elif has_env_key; then
    echo "   ✓ env.CLAUDE_CODE_SUBAGENT_MODEL présent"
  else
    echo "   ✗ env.CLAUDE_CODE_SUBAGENT_MODEL absent → ./script/claude sync"
    ok=false
  fi
  echo ""

  echo "5. Intégration Neovim"
  if [[ -f "$repo_root/config/.config/nvim/lua/config/claude.lua" ]]; then
    echo "   ✓ config/claude.lua présent"
  else
    echo "   ✗ config/claude.lua manquant"
    ok=false
  fi
  echo ""

  if [[ "$ok" == "true" ]]; then
    echo "Tous les contrôles passent."
  else
    echo "Certains contrôles échouent — voir les remèdes ci-dessus."
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Routage des commandes
# ---------------------------------------------------------------------------

main_command="${1:-}"
sub_command="${2:-}"

case "$main_command" in
  sync)
    case "$sub_command" in
      "") sync_settings ;;
      -h|--help|help) sync_usage ;;
      *)
        echo "Option inconnue pour sync : $sub_command" >&2
        sync_usage >&2
        exit 2
        ;;
    esac
    ;;

  status)
    show_status
    ;;

  doctor)
    run_doctor_checks
    ;;

  ""|-h|--help|help)
    usage
    ;;

  *)
    echo "Commande inconnue : $main_command" >&2
    usage >&2
    exit 2
    ;;
esac
