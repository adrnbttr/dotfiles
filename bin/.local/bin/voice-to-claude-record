#!/usr/bin/env bash
# voice-to-claude-record — background worker.
#
# Records mic audio via parecord until it receives SIGTERM (from a second
# invocation of voice-to-claude), then runs voice-transcribe (whisper.cpp) and pipes the
# transcript into the last-focused nvim's Claude split.

set -uo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/voice-to-claude"
PID_FILE="$STATE_DIR/record.pid"
WAV_FILE="$STATE_DIR/record.wav"
TRANSCRIPT_FILE="$STATE_DIR/transcript.txt"
SOCKET_FILE="$STATE_DIR/nvim-socket"


mkdir -p "$STATE_DIR"
# Un wav non transcrit (echec precedent) n'est jamais ecrase : on le garde horodate.
if [[ -s "$WAV_FILE" ]]; then
  mv "$WAV_FILE" "$STATE_DIR/record-$(date +%Y%m%d-%H%M%S).wav"
fi
rm -f "$WAV_FILE" "$TRANSCRIPT_FILE"

notify() { notify-send -a "Voice to Claude" -t 2500 "Voice to Claude" "$1" || true; }
# Apres un enregistrement, tout echec donne le chemin du wav conserve.
fail() {
  local msg="$1"
  [[ -s "$WAV_FILE" ]] && msg="$msg (audio conserve : $WAV_FILE)"
  notify-send -a "Voice to Claude" -t 4000 -u critical "Voice to Claude" "$msg" || true
  exit 1
}

notify "🎤 Recording… press Super+V again to stop"

parecord --channels=1 --rate=16000 --format=s16le --file-format=wav "$WAV_FILE" &
REC_PID=$!
echo "$REC_PID" > "$PID_FILE"

# Block until the recorder stops (killed by the toggle script).
wait "$REC_PID" || true
rm -f "$PID_FILE"

if [[ ! -s "$WAV_FILE" ]]; then
  fail "No audio captured"
fi

notify "⏳ Transcribing…"

TRANSCRIBE="$(dirname "$(readlink -f "$0")")/voice-transcribe"
ERR_FILE="$STATE_DIR/transcribe.err"
if ! TEXT="$("$TRANSCRIBE" "$WAV_FILE" 2>"$ERR_FILE")"; then
  fail "Transcription failed: $(head -c 300 "$ERR_FILE")"
fi

if [[ -z "${TEXT// }" ]]; then
  notify "No speech detected"
  exit 0
fi

if [[ ! -f "$SOCKET_FILE" ]]; then
  fail "No nvim instance registered (focus an nvim window first)"
fi

SOCKET="$(cat "$SOCKET_FILE")"
if [[ -z "$SOCKET" ]] || [[ ! -S "$SOCKET" ]]; then
  fail "nvim socket '$SOCKET' is stale"
fi

printf '%s' "$TEXT" > "$TRANSCRIPT_FILE"

if ! nvim --server "$SOCKET" --remote-expr \
  "v:lua.claude_nvim.send_from_file('$TRANSCRIPT_FILE')" >/dev/null 2>&1; then
  fail "Failed to send to nvim ($SOCKET)"
fi

notify "✓ Sent: ${TEXT:0:80}"
rm -f "$WAV_FILE"
