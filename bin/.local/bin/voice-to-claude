#!/usr/bin/env bash
# voice-to-claude — toggle: start a recording, or stop the running one.
#
# Bound to a global Cinnamon shortcut (see script/install). Each press flips
# the state: first press spawns a background worker (voice-to-claude-record)
# that records audio; second press sends SIGTERM to that worker, which then
# transcribes and forwards the text to the last-focused nvim.

set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/voice-to-claude"
PID_FILE="$STATE_DIR/record.pid"

mkdir -p "$STATE_DIR"

if [[ -f "$PID_FILE" ]]; then
  pid="$(cat "$PID_FILE")"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid"
    exit 0
  fi
  rm -f "$PID_FILE"
fi

setsid -f "$(dirname "$(readlink -f "$0")")/voice-to-claude-record" \
  </dev/null >/dev/null 2>&1
