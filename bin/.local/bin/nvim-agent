#!/usr/bin/env bash
# nvim-agent : ouvre Neovim avec l'onglet agent (claude ou opencode), comme <leader>zT / <leader>jT.
#
#   nvim-agent --agent <claude|opencode> [--last|--new] [--prompt <p>] [--env NOM=VALEUR]... [args nvim...] [-- args agent...]
#   nvim-agent --resume <id> [--agent <claude|opencode>] [--prompt <p>] [--env NOM=VALEUR]... [args nvim...] [-- args agent...]
#
# Avant « -- » : --agent, --prompt, --last, --new, --resume, --env sont consommés ; tout le reste va à nvim.
# --env NOM=VALEUR (répétable) : exporte la variable avant de lancer nvim ; nvim et le terminal de l'agent
# l'héritent. La valeur est prise telle quelle (aucune interprétation shell). NOM : [A-Za-z_][A-Za-z0-9_]*.
# opencode est toujours lancé avec --standalone --auto ; --resume <id> devient -s <id>. --resume avec
# --prompt n'est permis que pour opencode (claude : refusé).
# Après « -- » : chaque argument est relayé tel quel à l'agent (espaces, retours ligne, chaîne vide).
# --resume reprend la session <id> ; l'agent par défaut est claude.
#
# La demande passe par un fichier temporaire (champs terminés par NUL : v1, agent, mode, id, prompt,
# puis les arguments de l'agent), lu par config.ai_tab.request() dans Neovim, qui le supprime après
# lecture. Le script lance nvim en enfant (pas d'exec) pour supprimer lui aussi le fichier à la sortie
# (nvim qui sort sans exécuter -c : --version, -h...), y compris sur INT/TERM/HUP, et rend le code de
# nvim. Le pid du pane tmux n'est donc pas celui de nvim : deck suit le PID du hook, pas pane_pid.
# Variable NVIM_AGENT_NVIM : binaire nvim à lancer (tests) ; sinon « nvim » du PATH.
set -euo pipefail

usage() {
  cat <<'USAGE'
usage : nvim-agent --agent <claude|opencode> [--last|--new] [--prompt <texte>] [--env NOM=VALEUR]... [args nvim...] [-- args agent...]
        nvim-agent --resume <id> [--agent <claude|opencode>] [--prompt <texte>] [--env NOM=VALEUR]... [args nvim...] [-- args agent...]

  --agent <nom>    agent à ouvrir (claude ou opencode)
  --last | --new   reprendre la dernière conversation | session neuve (défaut) ; incompatibles
  --prompt <texte> message initial (mode exécution)
  --resume <id>    reprendre la session <id> (agent par défaut : claude) ; incompatible avec
                   --last et --new ; avec --prompt, seulement pour opencode
  --env NOM=VALEUR variable d'environnement vue par nvim et l'agent (répétable, valeur intacte)
  --               ce qui suit est relayé tel quel à l'agent. Ne pas y relayer d'option variadique de
                   claude (--add-dir, --allowedTools, --disallowedTools, --mcp-config) sans valeur
                   terminale : le prompt placé ensuite serait pris comme valeur de l'option.
  -h, --help       cette aide
USAGE
}

die() {
  echo "nvim-agent: $*" >&2
  exit 2
}

agent="" last=0 new=0 has_prompt=0 prompt="" has_resume=0 resume_id=""
nvim_args=()
agent_args=()
env_vars=()

while (($#)); do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      agent_args=("$@")
      break
      ;;
    --agent)
      if [[ $# -lt 2 || "$2" == -* ]]; then
        die "--agent demande un nom (claude ou opencode)"
      fi
      agent="$2"
      shift
      ;;
    --prompt)
      if [[ $# -lt 2 ]]; then
        die "--prompt demande un texte"
      fi
      has_prompt=1
      prompt="$2"
      shift
      ;;
    --resume)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        die "--resume demande un identifiant de session (non vide, ne commençant pas par -)"
      fi
      has_resume=1
      resume_id="$2"
      shift
      ;;
    --env)
      if [[ $# -lt 2 ]]; then
        die "--env demande NOM=VALEUR"
      fi
      if [[ ! "$2" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
        die "--env : NOM=VALEUR attendu, NOM de la forme [A-Za-z_][A-Za-z0-9_]* (reçu '${2%%=*}')"
      fi
      env_vars+=("$2")
      shift
      ;;
    --last) last=1 ;;
    --new) new=1 ;;
    *) nvim_args+=("$1") ;;
  esac
  shift
done

if ((has_resume)); then
  [[ -n "$agent" ]] || agent="claude"
  if ((last)) || ((new)); then
    die "--resume est incompatible avec --last et --new"
  fi
  if ((has_prompt)) && [[ "$agent" != "opencode" ]]; then
    die "--resume avec --prompt n'est permis que pour --agent opencode"
  fi
fi
if [[ -z "$agent" ]]; then
  usage >&2
  die "il faut --agent ou --resume"
fi
case "$agent" in
  claude | opencode) ;;
  *) die "agent inconnu '$agent' (attendu : claude ou opencode)" ;;
esac
if ((last && new)); then
  die "--new et --last sont incompatibles"
fi

mode="new"
((last)) && mode="last"
((has_resume)) && mode="resume"

tmpdir="${TMPDIR:-/tmp}"
if [[ "$tmpdir" != /* ]]; then
  die "TMPDIR doit être un chemin absolu (commençant par /) : '$tmpdir'"
fi
req=$(mktemp "$tmpdir/nvim-agent-req.XXXXXX")
child=""
# shellcheck disable=SC2317  # appelée indirectement par trap EXIT (faux positif)
cleanup() { rm -f -- "$req"; }
# sortie normale, erreur (set -e) ou signal : le fichier de requête ne reste jamais
trap cleanup EXIT
# le chemin entre dans une chaîne Lua : seuls des caractères sans danger sont acceptés
if [[ ! "$req" =~ ^[A-Za-z0-9/._-]+$ ]]; then
  die "chemin temporaire refusé ('$req') : TMPDIR doit être simple"
fi

{
  printf '%s\0' v1 "$agent" "$mode" "$resume_id" "$prompt"
  if ((${#agent_args[@]})); then
    printf '%s\0' "${agent_args[@]}"
  fi
} >"$req"

# signal reçu : relayé à nvim, qu'on attend avant de sortir avec 128+n (le trap EXIT nettoie)
# shellcheck disable=SC2317  # appelée indirectement par les trap INT/TERM/HUP (faux positif)
relay() {
  local sig=$1 num=$2
  if [[ -n "$child" ]]; then
    kill -s "$sig" "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
  fi
  exit $((128 + num))
}
trap 'relay INT 2' INT
trap 'relay TERM 15' TERM
trap 'relay HUP 1' HUP

# variables demandées : exportées ici, héritées par nvim puis par le terminal de l'agent (valeur intacte)
for kv in ${env_vars[@]+"${env_vars[@]}"}; do
  export "${kv%%=*}=${kv#*=}"
done

# en arrière-plan (sinon bash ne traite les signaux qu'à la sortie de nvim) ; <&0 garde le terminal
"${NVIM_AGENT_NVIM:-nvim}" -c "lua require('config.ai_tab').request('$req')" ${nvim_args[@]+"${nvim_args[@]}"} <&0 &
child=$!
rc=0
# wait est interrompu par un signal piégé (relay sort alors) ; sinon rc = code de nvim
wait "$child" || rc=$?
exit "$rc"
