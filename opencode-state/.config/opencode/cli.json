{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "flexoki"
  },
  "keybinds": {
    "session.rename": "ctrl+alt+r",
    "messages.copy": "ctrl+c"
  },
  "plugins": [
    {
      "package": "@renjfk/opencode-voice",
      "options": {
        "endpoint": "https://opencode.ai/zen/v1",
        "model": "deepseek-v4.1-flash",
        "apiKeyEnv": "OPENCODE_API_KEY",
        "sttLanguage": "fr",
        "reasoningEffort": "low",
        "maxTokens": 1024
      }
    }
  ],
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
