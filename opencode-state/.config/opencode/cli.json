{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "flexoki"
  },
  "keybinds": {
    "session.rename": "ctrl+alt+r",
    "messages.copy": "ctrl+c"
  },
  "plugins": [
    {
      "package": "./plugins/opencode-cost"
    }
  ],
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
