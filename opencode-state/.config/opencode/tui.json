{
  "$schema": "https://opencode.ai/tui.json",
  "plugin": [
    [
      "@renjfk/opencode-voice",
      {
        "endpoint": "https://openrouter.ai/api/v1",
        "model": "deepseek/deepseek-v4.1-flash",
        "apiKeyEnv": "OPENROUTER_API_KEY",
        "sttLanguage": "fr"
      }
    ]
  ],
  "keybinds": {
    "messages_copy": "ctrl+c",
    "session_rename": "ctrl+alt+r"
  }
}
