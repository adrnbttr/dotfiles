# Local-only Zsh config (not tracked).
#
# Copy to ~/.zshrc.local and put machine-specific paths / secrets here.
#
# Examples:
# export GITHUB_TOKEN="..."
# export PATH="$HOME/.local/opt/something/bin:$PATH"
# alias workvpn="..."

# opencode : clé OpenCode Zen (modèles + normalisation de la dictée)
# export OPENCODE_API_KEY="sk-..."
