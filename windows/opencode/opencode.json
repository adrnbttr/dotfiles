{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/claude-sonnet-5-5#high",
  "small_model": "opencode/deepseek-v4.1-flash",
  "default_agent": "plan",
  "providers": {
    "opencode": {
      "models": {
        "claude-sonnet-5-5": {
          "settings": { "reasoningEffort": "high" }
        }
      }
    }
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1280,
      "max_height": 1280,
      "max_base64_bytes": 5242880
    }
  },
  "compaction": {
    "auto": true
  },
  "formatter": true
}
