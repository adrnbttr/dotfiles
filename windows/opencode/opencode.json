{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/step-5-preview-free",
  "default_agent": "plan",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest", "--headless"]
      }
    }
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1280,
      "max_height": 1280,
      "max_base64_bytes": 5242880
    }
  },
  "compaction": {
    "auto": true
  },
  "formatter": true
}
